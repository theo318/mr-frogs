{
  "manifest_version": 3,
  "name": "Mr Frogs",
  "version": "0.1.0",
  "description": "Native ChatGPT UX for Mr Frogs. Your prompts become a sellable intent profile you control.",
  "permissions": ["storage"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["sidebar.css"],
      "matches": ["https://chatgpt.com/*"]
    }
  ]
}
