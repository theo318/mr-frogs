ANTHROPIC_API_KEY=sk-ant-...

# --- Overmind (optional) ---
# Sign in at https://console.overmindlab.ai, create a project, then copy the
# API key from project settings. With this set, every Anthropic call and every
# policy decision shows up as a span in the Overmind console.
OVERMIND_API_KEY=ovr_...
# OTLP endpoint. Defaults to https://api.overmindlab.ai/api/v1/traces if unset.
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.overmindlab.ai/api/v1/traces
